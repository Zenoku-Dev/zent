<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp">
            <ImageView
                android:src="@mipmap/ic_launcher"
                android:layout_width="52dp"
                android:layout_height="52dp" />
            <TextView
                android:id="@+id/title"
                android:text="Zent Mail"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tagline"
            android:text="@string/tagline"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:layout_marginBottom="36dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card"
            android:elevation="1dp"
            android:padding="20dp"
            android:layout_marginHorizontal="8dp"
            android:outlineProvider="background">

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/email_hint"
                android:inputType="textEmailAddress|textNoSuggestions|textAutoCorrect"
                android:autofillHints="email"
                android:background="@drawable/input_fill"
                android:paddingHorizontal="12dp"
                android:textSize="15sp" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/password_hint"
                android:inputType="textPassword|textNoSuggestions"
                android:autofillHints="password"
                android:background="@drawable/input_fill"
                android:paddingHorizontal="12dp"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B91C1C"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:minHeight="18dp" />

            <Button
                android:id="@+id/sign_in"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/sign_in"
                android:backgroundTint="@color/accent"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
